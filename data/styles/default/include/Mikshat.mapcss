/* Shared by browsing, outdoors and vehicle styles, after their base rules.
 * Keep outdoor rules available from z6: the renderer applies the actual
 * metric-ruler thresholds for each class on the current screen. Geometry
 * promotion supplies missing geometry in Country maps; World stays unchanged.
 */

/* Settlements retain their collision priorities and capital symbols. */
node|z7-9[place=city]
{font-size: 14;}
node|z10-12[place=city]
{font-size: 16;}
node|z13-[place=city]
{font-size: 18;}

node|z9-[place=town]
{text: name; font-size: 14; text-color: @city_label; text-halo-color: @label_halo_light; text-halo-radius: 1; text-halo-opacity: 0.9;}
node|z13-[place=town]
{font-size: 16;}

node|z9-[place=village],
node|z9-[place=hamlet]
{text: name; font-size: 12; text-color: @mikshat_settlement_label; text-halo-color: @label_halo_light; text-halo-radius: 1; text-halo-opacity: 0.9;}
node|z11-[place=village]
{font-size: 13;}
node|z13-[place=village],
node|z13-[place=hamlet]
{font-size: 14;}
node|z9-[place=village]::int_name,
node|z9-[place=hamlet]::int_name
{text: int_name; font-size: 10; text-color: @mikshat_settlement_label; text-halo-color: @label_halo_light; text-halo-radius: 1; text-halo-opacity: 0.9;}
node|z13-[place=village]::int_name,
node|z13-[place=hamlet]::int_name
{font-size: 11;}

/* Intermittent streams/rivers inherit this blue name styling. Canals and
 * drains keep their separate base treatment. Tunnel waterways stay hidden.
 */
line|z6-[waterway=river],
line|z6-[waterway=stream]
{text: name; font-size: 11; text-position: line; text-color: @mikshat_wadi_label; text-halo-color: @label_halo_light; text-halo-radius: 1; text-halo-opacity: 0.8;}
line|z15-[waterway=river],
line|z15-[waterway=stream]
{font-size: 12;}
line|z6-9[waterway=river][!tunnel],
line|z6-12[waterway=stream][!tunnel]
{color: @river; width: 0.7;}
line[waterway][tunnel]
{text: none;}

/* Tracks identify the mapped unsealed-road class. Do not recolor paved
 * residential/service roads merely because they are minor roads.
 */
line|z9-13[highway=track][!tunnel]
{color: @track; width: 0.8; opacity: 0.9; dashes: 5,3;}
line|z14-15[highway=track][!tunnel]
{width: 1.1; dashes: 6,2.5;}
line|z9-14[highway=track][!tunnel]
{text: name; text-position: line; font-size: 10; text-color: @mikshat_dirt_road; text-halo-color: @label_halo_light; text-halo-radius: 1; text-halo-opacity: 0.9;}

/* Small icons are spaced at overview scales. Existing overlay priorities
 * still resolve collisions; names become available on closer inspection.
 */
node|z9-13[amenity=fuel],
area|z9-13[amenity=fuel]
{icon-image: fuel-s.svg; icon-min-distance: 48;}
node|z12-13[amenity=fuel],
area|z12-13[amenity=fuel]
{text: name; font-size: 10; text-color: @poi_label; text-offset: 1;}

node|z9-[natural=spring],
node|z9-[natural=hot_spring],
node|z9-[amenity=water_point],
node|z9-[amenity=drinking_water],
node|z9-[man_made=water_tap],
node|z9-[man_made=water_well]
{icon-image: drinking-water-s.svg; icon-min-distance: 48;}
node|z12-[natural=spring],
node|z12-[natural=hot_spring],
node|z12-[amenity=water_point],
node|z12-[amenity=drinking_water],
node|z12-[man_made=water_tap],
node|z12-[man_made=water_well]
{text: name; font-size: 10; text-color: @poi_label; text-offset: 1;}
node|z17-[natural=spring],
node|z17-[natural=hot_spring],
node|z17-[amenity=water_point],
node|z17-[amenity=drinking_water],
node|z17-[man_made=water_tap],
node|z17-[man_made=water_well]
{icon-image: drinking-water-m.svg; icon-min-distance: 0; font-size: 11;}

/* Preserve explicit non-potable water information at every new scale. */
node|z9-[natural=spring][drinking_water=not],
node|z9-[man_made=water_tap][drinking_water=not],
node|z9-[man_made=water_well][drinking_water=not],
node|z9-[amenity=water_point][drinking_water=not]
{icon-image: drinking-water-no-s.svg; icon-min-distance: 48;}
node|z17-[natural=spring][drinking_water=not],
node|z17-[man_made=water_tap][drinking_water=not],
node|z17-[man_made=water_well][drinking_water=not],
node|z17-[amenity=water_point][drinking_water=not]
{icon-image: drinking-water-no-m.svg; icon-min-distance: 0;}

/* A vegetated fayda can be mapped as meadow/grassland. These landcover
 * classes and the explicitly named faydas below retain green names.
 */
node|z6-[landuse=meadow],
area|z6-[landuse=meadow],
node|z6-[natural=grassland],
area|z6-[natural=grassland]
{text: name; text-position: center; font-size: 11; text-color: @mikshat_fayda_label; text-halo-color: @label_halo_light; text-halo-radius: 1; text-halo-opacity: 0.9;}
node|z14-[landuse=meadow],
area|z14-[landuse=meadow],
node|z14-[natural=grassland],
area|z14-[natural=grassland]
{font-size: 12;}

/* Explicitly named faydat that use the generic existing locality class.
 * Test the stored feature name at runtime to retain their green treatment.
 */
node|z6-[place=locality][named_fayda],
area|z6-[place=locality][named_fayda],
node|z6-[natural=wetland][named_fayda],
area|z6-[natural=wetland][named_fayda]
{text: name; text-position: center; font-size: 12; text-color: @mikshat_fayda_label; text-halo-color: @label_halo_light; text-halo-radius: 1; text-halo-opacity: 0.9;}
node|z14-[place=locality][named_fayda],
area|z14-[place=locality][named_fayda],
node|z14-[natural=wetland][named_fayda],
area|z14-[natural=wetland][named_fayda]
{font-size: 13;}

/* The audited sandy landmarks use the existing locality class. Keep that
 * class uniform without recoloring separately classified farms or hamlets;
 * explicitly named faydas retain their green treatment above.
 */
node|z6-[place=locality][!named_fayda],
area|z6-[place=locality][!named_fayda]
{text: name; text-position: center; text-offset: 0; font-size: 14; text-color: @mikshat_sand_label; text-halo-color: @mikshat_sand_halo; text-halo-radius: 1.2; text-halo-opacity: 0.95;}
node|z14-[place=locality][!named_fayda],
area|z14-[place=locality][!named_fayda]
{font-size: 15;}
node|z13-[place=locality][!named_fayda]::int_name
{text-color: @mikshat_sand_label; text-halo-color: @mikshat_sand_halo; font-size: 12;}

/* The complementary wetland branch keeps ordinary wetlands unchanged. */
node|z6-[natural=wetland][!named_fayda],
area|z6-[natural=wetland][!named_fayda]
{}

/* Surface metadata distinguishes genuinely unpaved motor roads from paved
 * service/residential roads. Keep their widths, casings and priorities.
 */
/* Supply an overview stroke before each motor-road class has a base width.
 * Runtime surface classification keeps paved roads on their original style.
 */
line|z6-8[highway=track][!tunnel][unpaved_road],
line|z6-13[highway=track][tunnel][unpaved_road],
line|z6-9[highway=motorway_link][unpaved_road],
line|z6-9[highway=trunk_link][unpaved_road],
line|z6-7[highway=primary][unpaved_road],
line|z6-10[highway=primary_link][unpaved_road],
line|z6-9[highway=secondary][unpaved_road],
line|z6-12[highway=secondary_link][unpaved_road],
line|z6-10[highway=tertiary][unpaved_road],
line|z6-13[highway=tertiary_link][unpaved_road],
line|z6-10[highway=unclassified][unpaved_road],
line|z6-11[highway=residential][unpaved_road],
line|z6-11[highway=living_street][unpaved_road],
line|z6-11[highway=road][unpaved_road],
line|z6-12[highway=service][unpaved_road]
{width: 0.8;}
line|z6-[highway][unpaved_road]
{color: @mikshat_dirt_road; opacity: 1; dashes: none; casing-dashes: none;}
line|z6-[highway][unpaved_road]::tunnelCasing
{casing-dashes: none;}
line|z6-[highway=motorway][unpaved_road],
line|z6-[highway=motorway_link][unpaved_road],
line|z6-[highway=trunk][unpaved_road],
line|z6-[highway=trunk_link][unpaved_road],
line|z6-[highway=primary][unpaved_road],
line|z6-[highway=primary_link][unpaved_road],
line|z6-[highway=secondary][unpaved_road],
line|z6-[highway=secondary_link][unpaved_road],
line|z6-[highway=tertiary][unpaved_road],
line|z6-[highway=tertiary_link][unpaved_road],
line|z6-[highway=unclassified][unpaved_road],
line|z6-[highway=residential][unpaved_road],
line|z6-[highway=living_street][unpaved_road],
line|z6-[highway=road][unpaved_road],
line|z6-[highway=service][unpaved_road],
line|z6-[highway=track][unpaved_road]
{text: name; text-position: line; text-color: @mikshat_dirt_road; text-halo-color: @label_halo_light; text-halo-radius: 1; text-halo-opacity: 0.9;}
line|z6-[highway][!unpaved_road]
{}


/* Protected names, boundaries and fill share one style at every source and
 * protection class. The renderer hides them above the 50 km metric ruler,
 * then removes only fill/hatching at 2 km and closer.
 */
area|z6-[boundary=national_park],
area|z6-[boundary=protected_area],
area|z6-[leisure=nature_reserve]
{fill-color: @mikshat_protected_fill; fill-opacity: 0.3;}

node|z6-[boundary=national_park],
area|z6-[boundary=national_park],
node|z6-[boundary=protected_area],
area|z6-[boundary=protected_area],
node|z6-[leisure=nature_reserve],
area|z6-[leisure=nature_reserve]
{text: name; text-position: center; text-offset: 1; font-size: 12; text-color: @mikshat_protected_border; text-halo-color: @label_halo_light; text-halo-radius: 1; text-halo-opacity: 0.95; text-optional: false;}

node|z13-[boundary=national_park],
area|z13-[boundary=national_park],
node|z13-[boundary=protected_area],
area|z13-[boundary=protected_area],
node|z13-[leisure=nature_reserve],
area|z13-[leisure=nature_reserve]
{font-size: 13;}

line|z6-[boundary=national_park],
line|z6-[boundary=protected_area],
line|z6-[leisure=nature_reserve]
{color: @mikshat_protected_border; width: 1; dashes: none;}
line|z10-12[boundary=national_park],
line|z10-12[boundary=protected_area],
line|z10-12[leisure=nature_reserve]
{width: 1.5;}
line|z13-15[boundary=national_park],
line|z13-15[boundary=protected_area],
line|z13-15[leisure=nature_reserve]
{width: 2.2;}
line|z16-[boundary=national_park],
line|z16-[boundary=protected_area],
line|z16-[leisure=nature_reserve]
{width: 3;}


/* Sandy terrain names remain black in both themes, with a light outline so
 * their larger lettering stays readable over the sand and dark backgrounds.
 */
node|z6-[natural=desert],
area|z6-[natural=desert],
node|z6-[natural=beach][surface=sand],
area|z6-[natural=beach][surface=sand]
{text: name; text-position: center; text-offset: 1; font-size: 14; text-color: @mikshat_sand_label; text-halo-color: @mikshat_sand_halo; text-halo-radius: 1.2; text-halo-opacity: 0.95;}
node|z14-[natural=desert],
area|z14-[natural=desert],
node|z14-[natural=beach][surface=sand],
area|z14-[natural=beach][surface=sand]
{font-size: 15;}

line|z15-[highway=track][unpaved_road]
{font-size: 11;}
line|z18-[highway=track][unpaved_road]
{font-size: 12;}
